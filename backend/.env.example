# Copie para .env (nunca versionar). Obrigatório em produção:
JWT_SECRET=gere-com-openssl-rand-base64-48-um-valor-unico-por-ambiente
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/postgres?sslmode=require
DB_USER=
DB_PASSWORD=
# Opcional
# Cifra as chaves de API do assistente (padrão: deriva do JWT_SECRET). Trocar invalida as chaves salvas.
AI_KEY_SECRET=
JWT_EXPIRATION_MS=43200000
# Assistente no Telegram (opcional): token do @BotFather, um segredo aleatório e a URL pública do app
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
APP_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=
SMTP_USER=
SMTP_PASS=
